# Build outputs (will be created inside container)
build_arm/
build_sys/
cmake-build*/
out/

# Git files
.git/
.gitignore
.gitattributes

# IDE files
.idea/
.vscode/
.vs/
.run/
*.user

# OS files
.DS_Store

# Backup files
backup/

# Docker files (don't copy into container)
Dockerfile
.dockerignore
docker-compose.yml

# Documentation and project files
*.md
docs/

# GitHub specific
.github/

# Tests (x86_64 only, not needed for ARM build)
autobleem/tests/

# Database files (regenerated during build)
autobleem/db/

# Payload structure (USB deployment files, not needed for build)
autobleem/payload/

# except libs.tar.gz: the Docker build re-packages it with new SDL2 libs while
# preserving libogg/libvorbis*/libmamecd/libiconv from the original archive.
# Without this re-inclusion the preservation step would silently produce a
# tarball containing only the SDL2 family; see Dockerfile RUN that rebuilds
# /build/build_arm/libs.tar.gz.
!autobleem/payload/Autobleem/
!autobleem/payload/Autobleem/lib/
!autobleem/payload/Autobleem/lib/libs.tar.gz
